{
  "name": "lunarvow-access",
  "account_id": "0054778f20f99a987248d4d7b4dc5b59",
  "auth_origin": "https://lunarvow-access.bernie-lunarvow.workers.dev",
  "site_origin": "https://bernie8026.github.io",
  "compatibility_date": "2026-11-01",
  "main_module": "passkey-worker.mjs",
  "build": "node scripts/build-access-worker.cjs",
  "durable_object": { "binding": "IP_GUARD", "class_name": "IpAttemptGuard", "storage": "sqlite" },
  "passkey_registry": { "binding": "PASSKEYS", "class_name": "PasskeyRegistry", "storage": "sqlite" },
  "migration": { "new_tag": "ip-guard-v1", "new_sqlite_classes": ["IpAttemptGuard"] },
  "passkey_migration": { "old_tag": "ip-guard-v1", "new_tag": "passkeys-v1", "new_sqlite_classes": ["PasskeyRegistry"] },
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "secret_names": ["ARCHIVE_KEY_B64", "IP_HMAC_KEY_B64", "ADMIN_TOKEN_SHA256"],
  "lunar_vault_bindings": { "variable": "LUNAR_VAULT_ARCHIVE_ID", "secret": "LUNAR_VAULT_KEY_B64" }
}
